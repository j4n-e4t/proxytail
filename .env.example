# --- Tailscale ---
# Two nodes join the tailnet: the UI node (proxytail, tag:proxytail) and Traefik's node (proxytail-edge,
# tag:proxytail-edge). Auth keys are only needed on first start.
TS_AUTHKEY=
TS_HOSTNAME=proxytail
# Auth key for the edge node (falls back to TS_AUTHKEY). Create it with tag:proxytail-edge.
TS_EDGE_AUTHKEY=
TS_EDGE_HOSTNAME=proxytail-edge
# Defaults to --advertise-tags=tag:proxytail-edge. Keep a tag here: the tailnet policy scopes the edge node by it.
TS_EDGE_EXTRA_ARGS=
# Only peers with this tag are listed and can be targeted (can also be set in Settings).
TS_BACKEND_TAG=tag:proxytail-backend

# --- Proxy ---
# Public IP/hostname your domains' wildcard records point at (can also be set in Settings).
PUBLIC_ADDRESS=
# Host ports Traefik serves public traffic on. Port 80 must be reachable from the internet for
# Let's Encrypt's HTTP-01 challenge; all other HTTP requests are redirected to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
# Optional contact email for the Let's Encrypt account.
ACME_EMAIL=
# ACME directory. Defaults to Let's Encrypt production (dev compose: staging).
ACME_CA_SERVER=

# --- proxytail UI (docker-compose.yml) ---
# The UI is served on the tailnet only. Roles come from app capability grants under this name in the tailnet
# policy (default proxytail.dev/cap/ui).
TS_APP_CAPABILITY=
# Extra hostnames the UI may be opened under, comma-separated. Its MagicDNS names and IPs always work.
UI_HOSTS=
# Pin a version instead of :latest, e.g. ghcr.io/j4n-e4t/proxytail:0.1.0
PROXYTAIL_IMAGE=ghcr.io/j4n-e4t/proxytail:latest

# --- Development only (docker-compose.dev.yml, app on the host) ---
# `bun run dev` sets UI_AUTH=off: there's no tailscaled socket on the host to identify users with.
PORT=3000
TRAEFIK_API_URL=http://localhost:8080
TRAEFIK_DASHBOARD_PORT=8080
# Ephemeral auth key for the optional demo peer (falls back to TS_AUTHKEY).
TS_DEMO_AUTHKEY=
