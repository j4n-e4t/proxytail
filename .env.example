# --- Tailscale ---
# Read-only OAuth client for listing peers: create it in the admin console with only the devices:core:read scope.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
# Tailnet ID; "-" (the default) is the OAuth client's own tailnet.
TS_TAILNET=
# Only peers with this tag are listed and can be targeted (can also be set in Settings).
TS_BACKEND_TAG=tag:proxytail-backend

# --- Proxy ---
# Public IP/hostname your domains' wildcard records point at (can also be set in Settings).
PUBLIC_ADDRESS=
# Host ports Traefik serves public traffic on. Port 80 must be reachable from the internet for
# Let's Encrypt's HTTP-01 challenge; all other HTTP requests are redirected to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
# Optional contact email for the Let's Encrypt account.
ACME_EMAIL=
# ACME directory. Defaults to Let's Encrypt production (dev compose: staging).
ACME_CA_SERVER=
# Oldest TLS version clients may use: 1.2 (default) or 1.3.
TLS_MIN_VERSION=1.2
# Traefik image, if not docker-compose.yml's traefik:v3.7.13. It runs as an unprivileged user, whatever the image's
# default. Lines before v3.6.11 miss mTLS and request-smuggling fixes this configuration relies on.
#TRAEFIK_IMAGE=traefik:v3.7.13

# --- Rate limiting ---
# Valkey image tag, for rate limit counters that survive Traefik reloads (Security → Rate limiting).
VALKEY_VERSION=9.1

# --- proxytail UI (docker-compose.yml) ---
# Host loopback port the UI is published on, for `tailscale serve`. There is no login: anyone who can reach it has
# full access.
UI_PORT=3000
# Extra hostnames the UI may be opened under, comma-separated. IPs, localhost and *.ts.net names always work.
UI_HOSTS=
# Pin a version instead of :latest, e.g. ghcr.io/j4n-e4t/proxytail:0.1.0
PROXYTAIL_IMAGE=ghcr.io/j4n-e4t/proxytail:latest
# Memory limits per container.
APP_MEM_LIMIT=256m
TRAEFIK_MEM_LIMIT=512m

# --- Development only (docker-compose.dev.yml, app on the host) ---
PORT=3000
TRAEFIK_API_URL=http://localhost:8080
TRAEFIK_DASHBOARD_PORT=8080
VALKEY_ADDR=localhost:6379
# Auth key for the optional ephemeral demo peer (TS_DEMO_AUTHKEY, falling back to TS_AUTHKEY).
TS_DEMO_AUTHKEY=
