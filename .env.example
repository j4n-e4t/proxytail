# --- Tailscale ---
# Auth key for the Traefik node to join the tailnet (only needed on first start).
TS_AUTHKEY=
TS_HOSTNAME=proxytail
# Tailscale API credentials (can also be set in the UI → Settings). Prefer an OAuth client with
# the devices:core:read scope — it doesn't expire. Alternatively an API access token.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
TS_API_KEY=
# "-" = the default tailnet of the credentials.
TS_TAILNET=-

# --- Proxy ---
# Public IP/hostname your domains' wildcard records point at (can also be set in Settings).
PUBLIC_ADDRESS=
# Host ports Traefik serves public traffic on. Port 80 must be reachable from the internet for
# Let's Encrypt's HTTP-01 challenge; all other HTTP requests are redirected to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
# Optional contact email for the Let's Encrypt account.
ACME_EMAIL=
# ACME directory. Defaults to Let's Encrypt production (dev compose: staging).
ACME_CA_SERVER=

# --- proxytail UI (docker-compose.yml) ---
# The UI has no auth yet; keep it on localhost or a private interface.
UI_BIND=127.0.0.1
UI_PORT=3000
# Pin a version instead of :latest, e.g. ghcr.io/j4n-e4t/proxytail:0.1.0
PROXYTAIL_IMAGE=ghcr.io/j4n-e4t/proxytail:latest

# --- Development only (docker-compose.dev.yml, app on the host) ---
PORT=3000
TRAEFIK_API_URL=http://localhost:8080
TRAEFIK_DASHBOARD_PORT=8080
# Ephemeral auth key for the optional demo peer (falls back to TS_AUTHKEY).
TS_DEMO_AUTHKEY=
